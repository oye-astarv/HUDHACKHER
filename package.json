{
  "name": "safestride",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "dev:api": "node -e \"require('fs').mkdirSync('out',{recursive:true})\" && wrangler dev --port 8787",
    "build": "next build",
    "preview": "next build && wrangler dev --port 8787",
    "deploy": "next build && wrangler deploy",
    "typecheck": "tsc --noEmit && tsc --noEmit -p worker/tsconfig.json",
    "data:graph": "node scripts/build-data.mjs",
    "data:news": "node --env-file-if-exists=.dev.vars scripts/fetch-news.mjs"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "next": "^15.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-leaflet": "^5.0.0",
    "suncalc": "^1.9.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261118.1",
    "@types/leaflet": "^1.9.14",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@types/suncalc": "^1.9.2",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "wrangler": "^4.164.0"
  }
}
