# Copy to .env (git-ignored) before running `npm run data:news`.
#
# Optional: without it the news pipeline uses a keyword/street-name heuristic,
# which pins most headlines to "Huddersfield town centre" instead of named
# streets. Nothing else in the app needs a key.
#
# Get one at https://console.groq.com/keys
GROQ_API_KEY=

# Optional model override. Default: openai/gpt-oss-20b
# GROQ_MODEL=openai/gpt-oss-120b
