# Copy to .dev.vars (never commit it) and fill in your own values.
# Used by `wrangler dev`. For production use `npx wrangler secret put NAME`.

# --- Sender 1: Twilio (any volume, sends the map + live tracking links) ---
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
# An SMS-capable Twilio number in E.164, e.g. +447700900123.
# Trial accounts can only text numbers you have verified in the console.
TWILIO_SMS_FROM=+447700900123

# Minutes between automatic UPDATE texts while an alert is active (0 = off).
# Each update is one SMS per contact, so this is the main cost dial.
SMS_UPDATE_MINUTES=10

# Testing only: point the Twilio client at a local mock instead of the real API.
# TWILIO_BASE_URL=http://127.0.0.1:9099

# --- Sender 2: Textbelt (no monthly fee, one-time credit pack) ---
# Used automatically when the three Twilio values are absent. The public
# "textbelt" key refuses UK numbers, so only a purchased key is useful here.
# TEXTBELT_KEY=your_purchased_textbelt_key

# Origin for the tracking link sent to contacts. Leave unset in local dev: the
# Worker then uses whatever host the request came in on (localhost or LAN).
# PUBLIC_ORIGIN=https://safestride.example.workers.dev

# Only used by `npm run data:news` (node script, reads process.env)
GROQ_API_KEY=your_groq_key
